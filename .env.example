# Copy to .env.local for local testing (never commit .env.local).
# `npm run serve` loads .env.local automatically (not used on DigitalOcean production).

# —— Mailchimp (set on the server / DO App Platform env — never REACT_APP_) ——
# DC must match the suffix on your API key (e.g. key ending in us6 → MAILCHIMP_DC=us6).
# Form → Mailchimp: FNAME/LNAME, PHONE, COMPANY (company name), MESSAGE (enquiry text only), ADDRESS (plot/site line).
# Default merge tag for enquiry text is MESSAGE (your “Message” Text field). If Mailchimp returns 400, try MMERGE5:
# MAILCHIMP_MERGE_MESSAGE=MMERGE5
# Set MAILCHIMP_MERGE_MESSAGE= (empty) only to pack everything into COMPANY again.
#
# Site address defaults to merge tag ADDRESS as plain text (your “Address” Text field). For Mailchimp’s native
# Address-type field (multi-part JSON) instead, set:
# MAILCHIMP_ADDRESS_STRUCTURED=1
# MAILCHIMP_ADDRESS_COUNTRY=GB
#
# Send the address line to a different Text merge tag instead of ADDRESS (optional):
# MAILCHIMP_MERGE_LOCATION=MMERGE12
# MAILCHIMP_MERGE_ADDRESS=
#
# Project type (dropdown) defaults to merge tag PROJECT. If the API rejects it, try MMERGE7:
# MAILCHIMP_MERGE_PROJECT_TYPE=MMERGE7
# Set MAILCHIMP_MERGE_PROJECT_TYPE= (empty) to stop sending project type to Mailchimp.
#
# If subscribe returns 400 from Mailchimp about status / double opt-in, try:
# MAILCHIMP_STATUS_IF_NEW=pending
#
# Temporary debugging (set on the server, redeploy): logs request + returns mailchimpDebug in JSON response
# MAILCHIMP_DEBUG=1
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
MAILCHIMP_DC=us19
MAILCHIMP_STATUS_IF_NEW=subscribed

# Google Places (optional) — address suggestions on the form. Enable in Google Cloud: Maps JavaScript API + Places API
# (New), billing on, HTTP referrer restriction to your domain + localhost. Build-time env for Create React App.
# REACT_APP_GOOGLE_PLACES_API_KEY=

# Optional: full site URL when the React dev server calls a remote API (rare)
# REACT_APP_MAILCHIMP_API_URL=https://your-domain.com
#
# Production: the contact form POSTs to /api/subscribe. Pure static hosting (HTML/CSS/JS only) cannot run
# that route — deploy Node with server.js (npm run serve), or Vercel with api/subscribe.js, or point
# REACT_APP_MAILCHIMP_API_URL at a separate API origin that runs the subscribe handler.

# Digital Ocean App Platform sets PORT automatically; local `npm run serve` defaults to 8080.
# PORT=8080

# Copy to .env.local for local testing (never commit .env.local).
# `npm run serve` loads .env.local automatically (not used on DigitalOcean production).

# —— Mailchimp (set on the server / DO App Platform env — never REACT_APP_) ——
# DC must match the suffix on your API key (e.g. key ending in us6 → MAILCHIMP_DC=us6).
# Form → Mailchimp: FNAME/LNAME, PHONE, COMPANY (message). Do not use the default Address (ADDRESS) merge for free text.
# Custom Text field “location” with tag LOCATION is used by default — no env needed. If Mailchimp shows only MMERGE7, set:
# MAILCHIMP_MERGE_LOCATION=MMERGE7
# Set MAILCHIMP_MERGE_LOCATION= (empty) only if you want location folded into Company instead of its own field.
#
# Project type: custom Text field + merge tag, e.g.:
# MAILCHIMP_MERGE_PROJECT_TYPE=MMERGE8
#
# If subscribe returns 400 from Mailchimp about status / double opt-in, try:
# MAILCHIMP_STATUS_IF_NEW=pending
#
# Temporary debugging (set on the server, redeploy): logs request + returns mailchimpDebug in JSON response
# MAILCHIMP_DEBUG=1
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
MAILCHIMP_DC=us19
MAILCHIMP_STATUS_IF_NEW=subscribed

# Optional: full site URL when the React dev server calls a remote API (rare)
# REACT_APP_MAILCHIMP_API_URL=https://your-domain.com
#
# Production: the contact form POSTs to /api/subscribe. Pure static hosting (HTML/CSS/JS only) cannot run
# that route — deploy Node with server.js (npm run serve), or Vercel with api/subscribe.js, or point
# REACT_APP_MAILCHIMP_API_URL at a separate API origin that runs the subscribe handler.

# Digital Ocean App Platform sets PORT automatically; local `npm run serve` defaults to 8080.
# PORT=8080
